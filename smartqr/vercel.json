{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/m/:t",
      "destination": "/m.html"
    },
    {
      "source": "/sq/:code",
      "destination": "/api/sq?code=:code"
    },
    {
      "source": "/vcard/:slug",
      "destination": "/api/vcard?s=:slug"
    },
    {
      "source": "/:slug([a-z0-9-]{2,40})",
      "destination": "/p.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
